# WAY.APP integrado en WAY UP — plantilla de variables de entorno.
# TODAS son solo de servidor. Nunca uses prefijo VITE_ y nunca subas un .env real al repositorio.
# Local:      copia este archivo a .env y arranca con `npm run dev:env`.
# Producción: defínelas como secrets/variables del hosting (p. ej. `wrangler secret put NOMBRE`).

# IA (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Base de datos (Neon PostgreSQL)
NEON_DATABASE_URL=

# Rate limit distribuido (Upstash Redis REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Administración (Better Auth + Google OAuth)
BETTER_AUTH_SECRET=            # mínimo 32 caracteres aleatorios
BETTER_AUTH_URL=http://localhost:3000   # URL canónica de la web (en producción: https://wayup.es)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WAYAPP_ADMIN_EMAILS=           # correos autorizados, separados por comas

# Orígenes extra autorizados a llamar a /api/chat (opcional; el propio origen de la web ya está permitido)
WAYAPP_ALLOWED_ORIGINS=
